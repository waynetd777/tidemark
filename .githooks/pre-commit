#!/bin/sh
# sift: advisory sift lint on staged sift-directory files. Only W15, W16 and W19
# block a commit — a secret, a path outside the repo, or a tracked local/ file.
# W19 runs on every commit: one that only edits .gitignore can expose local/.
W=_sift
[ -d "$W/bin" ] || exit 0
only=W19
if git diff --cached --name-only -z | tr '\0' '\n' | grep -q "^$W/"; then
  python3 -I -S "$W/bin/sift.py" lint --staged
  only=W15,W16,W19
fi
out=$(python3 -I -S "$W/bin/sift.py" --json lint --staged --only "$only" 2>&1)
# A lint that crashed printed no envelope. That is not a clean result, and
# letting the commit through would make a broken check look like a passing one.
printf '%s' "$out" | grep -q '"ok":' || { echo "sift: lint failed to run, so this commit was not checked — commit blocked. Run: python3 $W/bin/sift.py lint --staged"; exit 1; }
printf '%s' "$out" | grep -q '"code": "W1[569]"' && { echo "sift: a secret, an out-of-repo path, or a committed local/ file — commit blocked"; exit 1; }
# Lint every language before a commit that touches code (make lint). Docs-only commits skip it.
if git diff --cached --name-only | grep -qvE '^(docs/|_sift/|[^/]*\.md$)'; then
  make -s lint >/tmp/tidemark-lint.$$ 2>&1 || {
    cat /tmp/tidemark-lint.$$
    rm -f /tmp/tidemark-lint.$$
    echo "lint failed: commit blocked. Fix it, or run make fmt for formatting."
    exit 1
  }
  rm -f /tmp/tidemark-lint.$$
fi
exit 0
