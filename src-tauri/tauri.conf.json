{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidemark",
  "version": "1.4.0",
  "identifier": "com.wayned.tidemark",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tidemark",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "visible": false
      },
      {
        "label": "tray",
        "url": "index.html?view=tray",
        "title": "Tidemark",
        "width": 360,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (c) 2026 Wayne Davies",
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": {
        "Library/LaunchAgents/com.wayned.tidemark.recorder.plist": "launchagent/com.wayned.tidemark.recorder.plist"
      }
    }
  }
}
