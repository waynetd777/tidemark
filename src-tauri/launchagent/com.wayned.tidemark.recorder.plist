<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tidemark's background helper (src/recorder.rs): the app's own binary, recording while the
     app is quit. Bundled into Contents/Library/LaunchAgents and registered with SMAppService. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wayned.tidemark.recorder</string>
  <key>BundleProgram</key>
  <string>Contents/MacOS/Tidemark</string>
  <key>ProgramArguments</key>
  <array>
    <string>Tidemark</string>
    <string>--record</string>
  </array>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>com.wayned.tidemark</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restarted only after a failure, and at most every 5 minutes, so a helper that can't run
       (a stale registration, say: see recorder.rs) retries rarely rather than all day. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
